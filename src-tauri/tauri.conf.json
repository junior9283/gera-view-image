{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gera View Image",
  "version": "0.4.0",
  "identifier": "io.github.junior9283.geraviewimage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gera View Image",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES"
    },
    "category": "GraphicsAndDesign",
    "shortDescription": "Visualizador e editor de imagens para Linux",
    "linux": {
      "deb": {
        "depends": [
          "libaom3"
        ],
        "recommends": [
          "libde265-0",
          "libkvazaar7"
        ],
        "desktopTemplate": "linux/gera-view-image.desktop.hbs"
      },
      "rpm": {
        "depends": [
          "libaom"
        ],
        "recommends": [
          "libde265",
          "libkvazaar.so.7()(64bit)"
        ],
        "desktopTemplate": "linux/gera-view-image.desktop.hbs"
      }
    }
  },
  "mainBinaryName": "gera-view-image",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/junior9283/gera-view-image/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFRUY1OUQ0ODI0MUM4RDMKUldUVHlFR0MxRm52RGpSL21zdXdhNjZGbi9TdlZvVUpaK3JiR2p3VEJJeEQ3b0F1M2NpdHRKWEIK"
    }
  }
}
