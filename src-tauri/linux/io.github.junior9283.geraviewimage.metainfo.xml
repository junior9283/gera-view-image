<!-- AppStream (lojas de aplicativos do Linux). O `npm run release` acrescenta cada versão nova em <releases>. -->
<component type="desktop-application">
  <id>io.github.junior9283.geraviewimage</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Gera View Image</name>
  <summary>Image viewer and editor</summary>
  <summary xml:lang="pt_BR">Visualizador e editor de imagens</summary>

  <developer id="io.github.junior9283">
    <name>junior9283</name>
  </developer>

  <description>
    <p>Gera View Image opens photos and images quickly and lets you make simple edits, in the style of the macOS Preview app.</p>
    <p xml:lang="pt_BR">O Gera View Image abre fotos e imagens com rapidez e permite edições simples, no estilo do Visualização do macOS.</p>
    <ul>
      <li>Thumbnails, contact sheet, tabs and slideshow</li>
      <li xml:lang="pt_BR">Miniaturas, folha de contatos, abas e apresentação</li>
      <li>Markup: shapes, text, arrows, highlights and signatures</li>
      <li xml:lang="pt_BR">Marcação: formas, texto, setas, realces e assinaturas</li>
      <li>Rotate, crop, resize, adjust color and remove the background</li>
      <li xml:lang="pt_BR">Girar, recortar, ajustar tamanho e cor e remover o fundo</li>
      <li>Inspector with EXIF, IPTC, GPS and image description</li>
      <li xml:lang="pt_BR">Inspetor com EXIF, IPTC, GPS e descrição da imagem</li>
      <li>Export to JPEG, PNG, TIFF, WebP, HEIC, AVIF and PDF, and print</li>
      <li xml:lang="pt_BR">Exportar em JPEG, PNG, TIFF, WebP, HEIC, AVIF e PDF, e imprimir</li>
    </ul>
  </description>

  <launchable type="desktop-id">Gera View Image.desktop</launchable>
  <url type="homepage">https://github.com/junior9283/gera-view-image</url>
  <url type="bugtracker">https://github.com/junior9283/gera-view-image/issues</url>

